generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MEMBER
}

enum OrgType {
  DOD
  FEDERAL_CIVILIAN
  SLED
  FOREIGN_GOVERNMENT
  COMMERCIAL
  ACADEMIC
  PARTNER_PRIME
  OTHER
}

enum Market {
  DEFENSE_DOD
  FEDERAL_CIVILIAN
  STATE_LOCAL
  AVIATION
  HEALTHCARE
  MANUFACTURING
  TECHNICAL_WORKFORCE
  EDUCATION_TRAINING
}

enum SharedDomainKind {
  UMBRELLA // shared gov domain (mail.mil, navy.mil): never auto-match to one org
  PERSONAL // gmail.com etc.
  IGNORED // "ignore domain" from the discovered-contacts queue
}

enum ContactSource {
  INSIGHTLY_IMPORT
  MANUAL
  GMAIL_DISCOVERED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
  DO_NOT_CONTACT
}

enum TeamFunction {
  BD
  SOLUTION_ENGINEERING
  SME
  PRODUCT
  LEADERSHIP
}

enum EngagementType {
  DIRECT
  VIA_PARTNER
  WHITE_LABEL
  LE_SERVICES
}

enum PartnerRole {
  CLIENT_FACING_PARTNER
  WHITE_LABEL_LICENSEE
  LE_SERVICES
  PRIME
  SUB
  END_CUSTOMER
}

enum StakeholderRole {
  ECONOMIC_BUYER
  MISSION_OWNER
  CHAMPION
  TECHNICAL_BUYER
  CYBERSECURITY
  PROCUREMENT
  END_USER
  DATA_SYSTEM_OWNER
  POTENTIAL_BLOCKER
}

enum OppStatus {
  OPEN
  ON_HOLD
  WON
  LOST
  NO_BID
}

enum Branch {
  A
  B
  C
}

enum EnvSubType {
  CUSTOMER_CLOUD
  GOV_CLOUD
  ON_PREM
  HYBRID
  RESTRICTED
}

enum ImpactLevel {
  IL2
  IL4
  IL5
  IL6
  OTHER
}

enum ProcurementVehicle {
  SBIR_PHASE_III
  OTA
  COMPETITIVE_RFP
  SOLE_SOURCE
  GSA_SCHEDULE
  CONTRACT_MOD
  VIA_PRIME_PARTNER
  COMMERCIAL_PO
  OTHER
}

enum ColorOfMoney {
  OM
  RDTE
  PROCUREMENT
  OTHER
  UNKNOWN
}

enum FundingStatus {
  UNIDENTIFIED
  IDENTIFIED
  PROGRAMMED
  APPROPRIATED
  OBLIGATED
}

enum TcvFlag {
  ESTIMATE
  QUOTED
  CONTRACTED
}

enum GoDecision {
  GO
  NO_GO
}

enum ValidationType {
  DEMO_ONLY
  GUIDED_EVALUATION
  PROOF_OF_VALUE
  PILOT
}

enum ContractSubStatus {
  PRICING
  PROPOSAL
  PROCUREMENT
  NEGOTIATION
  SECURITY_LEGAL_REVIEW
  AWARD
}

enum RequirementTag {
  CONFIGURATION
  CUSTOMIZATION
  CORE_PRODUCT_CANDIDATE
}

enum CriterionResult {
  MET
  PARTIALLY
  NOT_MET
}

enum Criterion {
  PROBLEM_SEVERITY
  CADRE_FIT
  CHAMPION
  DECISION_AUTHORITY
  FUNDING
  PROCUREMENT_PATH
  TIMELINE
  TECHNICAL_FEASIBILITY
}

enum Rating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum ActivityType {
  EMAIL
  MEETING
  CALL
  NOTE
  DEMO
  PROPOSAL_SUBMITTED
  RFI_RFP_RESPONSE
  CONFERENCE_TOUCH
}

enum DocType {
  DISCOVERY_NOTES
  QUALIFICATION
  SOLUTION_DESIGN
  SOW_DRAFT
  FOLLOW_UP_SUMMARY
  OTHER
}

enum AgreementType {
  CLIENT_FACING_PARTNER
  WHITE_LABEL_LICENSEE
  LE_SERVICES
}

enum AgreementStatus {
  PROSPECT
  NEGOTIATING
  ACTIVE
  EXPIRED
}

enum PricingModel {
  PER_SEAT
  PER_DEPLOYMENT
  ROYALTY_PCT
  FLAT_FEE
}

enum LicenseStatus {
  ACTIVE
  RENEWING
  LAPSED
}

enum AuditKind {
  STAGE
  GATE_OVERRIDE
  STATUS
  SCORECARD
  TCV
}

// ---------- Users & config ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(MEMBER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  ownedOrgs      Organization[]
  ownedContacts  Contact[]
  ownedOpps      Opportunity[]          @relation("OppOwner")
  deliveryOpps   Opportunity[]          @relation("OppDeliveryOwner")
  teamOn         OpportunityTeamMember[]
  tasks          Task[]
  activities     Activity[]
  participations ActivityParticipant[]
  auditEntries   AuditLog[]
}

/// Pipeline stages and their exit gates. Seeded from config/stages.json; editable without a code change.
model StageConfig {
  number Int    @id
  name   String
  gate   Json // GateRule[]
  onExit Json? // e.g. {"setStatus":"WON"}
}

/// Key/value settings (tier thresholds, stale windows). Seeded from config/tiers.json.
model Setting {
  key   String @id
  value Json
}

// ---------- Orgs & contacts ----------

model Organization {
  id        String    @id @default(cuid())
  name      String    @unique
  type      OrgType   @default(OTHER)
  market    Market?
  parentId  String?
  parent    Organization?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[] @relation("OrgTree")
  website   String?
  notes     String?
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  domains       OrgDomain[]
  contacts      Contact[]
  opportunities Opportunity[]
  partnerOn     OpportunityPartner[]
  agreements    PartnerAgreement[]
  activities    Activity[]
  licenses      License[]            @relation("LicenseCustomer")
  licensesVia   License[]            @relation("LicensePartner")

  @@index([parentId])
}

/// Email domains owned by exactly one org; used to match contacts and synced mail.
model OrgDomain {
  domain         String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Domains that must never be auto-matched to a single org.
model SharedDomain {
  domain String           @id
  kind   SharedDomainKind
  label  String?
}

model Contact {
  id             String        @id @default(cuid())
  firstName      String        @default("")
  lastName       String        @default("")
  title          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  phones         String[]
  linkedin       String?
  location       String?
  tags           String[]
  notes          String?
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  lastTouchAt    DateTime?
  source         ContactSource @default(MANUAL)
  status         ContactStatus @default(ACTIVE)
  importMeta     Json? // triage bucket, reason, reviewer notes from the import workbook
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  emails       ContactEmail[]
  stakeholderOn OpportunityStakeholder[]
  participations ActivityParticipant[]
  tasks        Task[]

  @@index([organizationId])
  @@index([lastName, firstName])
}

model ContactEmail {
  email     String  @id // always lower-case
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@index([contactId])
}

// ---------- Opportunities ----------

model Opportunity {
  id             String         @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId        String
  owner          User           @relation("OppOwner", fields: [ownerId], references: [id])
  engagementType EngagementType

  stage             Int               @default(1)
  status            OppStatus         @default(OPEN)
  holdReason        String?
  closeReason       String?
  contractSubStatus ContractSubStatus?

  // Deployment (Playbook 3.5)
  branch      Branch?
  envSubType  EnvSubType?
  impactLevel ImpactLevel?
  atoStatus   String?

  // Procurement & funding
  procurementVehicle ProcurementVehicle?
  contractVehicleId  String?
  contractVehicle    ContractVehicle?    @relation(fields: [contractVehicleId], references: [id], onDelete: SetNull)
  fundingSource      String?
  colorOfMoney       ColorOfMoney?
  fundingFy          Int?
  fundingStatus      FundingStatus?

  // Value & timing
  tcv             Decimal  @default(0) @db.Decimal(14, 2)
  tcvFlag         TcvFlag  @default(ESTIMATE)
  eduworksShare   Decimal? @db.Decimal(14, 2) // Eduworks' share of TCV on partner-led deals
  awardQuarter    Int? // 1-4, US federal FY (Q1 starts 1 Oct)
  awardFy         Int? // e.g. 2027

  // Problem statement (Playbook 1.3)
  problem      String?
  impact       String?
  desiredState String?
  solution     String?

  // Qualification
  goDecision  GoDecision?
  goRationale String?

  // Solution design (Playbook 3.4)
  designCapabilities String?
  designServices     String?
  designData         String?
  designIntegrations String?
  designConsulting   String?
  designApproach     String?

  // Validation
  validationType    ValidationType?
  validationOutcome String?

  // Scope (Playbook 3.8)
  scopeSoftware       String?
  scopeUsers          String?
  scopeData           String?
  scopeIntegrations   String?
  scopeServices       String?
  scopeInfrastructure String?
  scopeImplementation String?
  scopeSupport        String?
  licenseCount        Int?

  // Implementation handoff
  deliveryOwnerId String?
  deliveryOwner   User?     @relation("OppDeliveryOwner", fields: [deliveryOwnerId], references: [id], onDelete: SetNull)
  kickoffDate     DateTime?

  // Drive
  driveFolderId  String?
  driveFolderUrl String?

  // Expansion opportunities link back to the license they grow
  expandsLicenseId String?
  expandsLicense   License? @relation("Expansion", fields: [expandsLicenseId], references: [id], onDelete: SetNull)

  lastTouchAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teamMembers     OpportunityTeamMember[]
  partners        OpportunityPartner[]
  stakeholders    OpportunityStakeholder[]
  successCriteria SuccessCriterion[]
  requirements    SolutionRequirement[]
  scorecard       ScorecardRating[]
  documents       OpportunityDocument[]
  activities      Activity[]
  tasks           Task[]
  licenses        License[]               @relation("LicenseFromOpp")
  audit           AuditLog[]

  @@index([stage, status])
  @@index([organizationId])
  @@index([ownerId])
}

model OpportunityTeamMember {
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  function      TeamFunction

  @@id([opportunityId, userId])
}

model OpportunityPartner {
  id                   String       @id @default(cuid())
  opportunityId        String
  opportunity          Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                 PartnerRole
  customerContactOwner String? // who talks to the end customer
  notes                String?

  @@unique([opportunityId, organizationId, role])
  @@index([organizationId])
}

model OpportunityStakeholder {
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roles         StakeholderRole[]

  @@id([opportunityId, contactId])
  @@index([contactId])
}

model SuccessCriterion {
  id            String           @id @default(cuid())
  opportunityId String
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  text          String
  result        CriterionResult?
  evidence      String?
  createdAt     DateTime         @default(now())

  @@index([opportunityId])
}

model SolutionRequirement {
  id            String          @id @default(cuid())
  opportunityId String
  opportunity   Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  text          String
  tag           RequirementTag?
  createdAt     DateTime        @default(now())

  @@index([opportunityId])
}

model ScorecardRating {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  criterion     Criterion
  rating        Rating      @default(UNKNOWN)
  justification String?
  updatedAt     DateTime    @default(now()) // set explicitly when the rating is reviewed

  @@id([opportunityId, criterion])
}

model OpportunityDocument {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          DocType     @default(OTHER)
  title         String
  url           String
  driveFileId   String?
  createdAt     DateTime    @default(now())

  @@index([opportunityId])
}

// ---------- Partners, vehicles, post-sale ----------

model PartnerAgreement {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           AgreementType
  status         AgreementStatus @default(PROSPECT)
  startDate      DateTime?
  endDate        DateTime?
  docUrl         String?
  // white-label
  brandName          String?
  territory          String?
  pricingModel       PricingModel?
  minimumCommitments String?
  endCustomers       String?
  // services
  rateCard String?
  ceiling  Decimal? @db.Decimal(14, 2)
  notes    String?
  createdAt DateTime @default(now())

  @@index([organizationId])
}

model ContractVehicle {
  id       String    @id @default(cuid())
  name     String
  type     String?
  agency   String?
  number   String?
  ceiling  Decimal?  @db.Decimal(14, 2)
  popStart DateTime?
  popEnd   DateTime?
  notes    String?

  opportunities Opportunity[]
}

model License {
  id              String        @id @default(cuid())
  customerOrgId   String
  customerOrg     Organization  @relation("LicenseCustomer", fields: [customerOrgId], references: [id])
  opportunityId   String?
  opportunity     Opportunity?  @relation("LicenseFromOpp", fields: [opportunityId], references: [id], onDelete: SetNull)
  viaPartnerOrgId String?
  viaPartnerOrg   Organization? @relation("LicensePartner", fields: [viaPartnerOrgId], references: [id], onDelete: SetNull)
  licenseCount    Int?
  branch          Branch?
  termStart       DateTime?
  termEnd         DateTime?
  renewalDate     DateTime?
  value           Decimal?      @db.Decimal(14, 2)
  status          LicenseStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())

  expansions Opportunity[] @relation("Expansion")

  @@index([renewalDate])
}

// ---------- Activity, tasks, audit ----------

model Activity {
  id              String        @id @default(cuid())
  type            ActivityType
  occurredAt      DateTime
  subject         String
  snippet         String? // short snippet only; full email bodies are never stored
  link            String? // deep link back to Gmail / Calendar
  gmailThreadId   String?
  calendarEventId String?
  problemFocused  Boolean       @default(false) // demo tied to the problem statement (Stage 6 gate)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  participants ActivityParticipant[]

  @@index([opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
}

model ActivityParticipant {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([activityId])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  dueDate       DateTime?
  assigneeId    String?
  assignee      User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  done          Boolean      @default(false)
  doneAt        DateTime?
  isPrimary     Boolean      @default(false) // the opportunity's "next action"
  createdAt     DateTime     @default(now())

  @@index([assigneeId, done, dueDate])
  @@index([opportunityId])
}

model AuditLog {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          AuditKind
  field         String? // e.g. scorecard criterion
  oldValue      String?
  newValue      String?
  comment       String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  at            DateTime    @default(now())

  @@index([opportunityId, at])
}
