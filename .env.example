DATABASE_URL=postgresql://cadre:cadre@localhost:5432/cadre
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google Workspace domain allowed to sign in
ALLOWED_DOMAIN=eduworks.com
# Comma-separated emails that are made admin on sign-in
ADMIN_EMAILS=
# Local dev / e2e only: enables a password-less dev login. Ignored when NODE_ENV=production.
DEV_LOGIN=1
